<UserControl x:Class="RadioForge.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RadioForge.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Application Settings" Style="{StaticResource H1}" Margin="0,0,0,10"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="STATION PROFILES" Style="{StaticResource H2}"/>
                    <TextBlock Text="Each profile has its own servers, audio settings, playlists, soundboard, metadata, schedule and recording settings." Style="{StaticResource Muted}" FontSize="11.5"/>
                    <WrapPanel Margin="0,8,0,0">
                        <ComboBox x:Name="ProfileBox" Width="240" DisplayMemberPath="Name" Margin="0,0,8,6"/>
                        <Button Content="Switch" Click="OnSwitch" Margin="0,0,6,6"/><Button Content="＋ New" Click="OnNewProfile" Margin="0,0,6,6"/><Button Content="Rename" Click="OnRenameProfile" Margin="0,0,6,6"/>
                        <Button Content="Delete" Click="OnDeleteProfile" Margin="0,0,6,6"/><Button Content="Import…" Click="OnImportProfile" Margin="0,0,6,6"/><Button Content="Export…" Click="OnExportProfile" Margin="0,0,6,6"/>
                        <Button Content="Run setup wizard…" Click="OnWizard" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <TextBlock Text="Exports never contain saved passwords; re-enter them after importing." Style="{StaticResource Muted}" FontSize="11.5"/>
                    <Grid Margin="0,10,0,0" DataContext="{Binding Station.Profile}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Station name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
                        <TextBlock Grid.Column="3" Text="Genre" VerticalAlignment="Center"/><TextBox Grid.Column="4" Text="{Binding Genre}" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Text="Description" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Website" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Website}" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Text="DJ name" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Metadata.DjName}" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Time zone" VerticalAlignment="Center"/><ComboBox x:Name="TzBox" Grid.Row="2" Grid.Column="4" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding TimeZoneId}" Margin="0,3"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel DataContext="{Binding Settings}">
                    <TextBlock Text="INTERFACE" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Theme" Width="110" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Width="120" SelectedItem="{Binding Theme}" SelectionChanged="OnTheme"/>
                        <TextBlock Text="Accent" Margin="24,0,8,0" VerticalAlignment="Center"/><TextBox x:Name="AccentBox" Width="90" Text="{Binding AccentColor, UpdateSourceTrigger=LostFocus}" LostFocus="OnTheme"/>
                        <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="8,0,0,0"/>
                    </StackPanel>
                    <c:LabeledSlider Label="Font scaling" LabelWidth="110" Minimum="0.8" Maximum="1.6" Step="0.05" Value="{Binding FontScale, Mode=TwoWay}" Format="P0"/>
                    <Button Content="Apply scaling" Click="OnTheme" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    <TextBlock Text="Panels resize with the window; the visualizer, soundboard grid and mixer adapt to the available space." Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel DataContext="{Binding Settings}">
                    <TextBlock Text="BACKGROUND OPERATION &amp; NOTIFICATIONS" Style="{StaticResource H2}"/>
                    <CheckBox Content="Minimize to the system tray (broadcast keeps running)" IsChecked="{Binding MinimizeToTray}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6"><TextBlock Text="When closing the window during a broadcast" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="CloseBox" Width="200" SelectedItem="{Binding CloseBehavior}"/></StackPanel>
                    <WrapPanel>
                        <CheckBox Content="Server disconnected" IsChecked="{Binding NotifyDisconnect}" Width="230"/><CheckBox Content="Server reconnected" IsChecked="{Binding NotifyReconnect}" Width="230"/>
                        <CheckBox Content="Authentication failure" IsChecked="{Binding NotifyAuth}" Width="230"/><CheckBox Content="Recording completed" IsChecked="{Binding NotifyRecording}" Width="230"/>
                        <CheckBox Content="Scheduled show starting" IsChecked="{Binding NotifySchedule}" Width="230"/><CheckBox Content="Missing audio file" IsChecked="{Binding NotifyMissingFile}" Width="230"/>
                        <CheckBox Content="Microphone clipping" IsChecked="{Binding NotifyClipping}" Width="230"/><CheckBox Content="Audio device problems" IsChecked="{Binding NotifyDevice}" Width="230"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource H2}"/>
                    <TextBlock Text="Active while RadioForge is focused (so they never clash with other applications). Click a shortcut, then press the new combination." Style="{StaticResource Muted}" FontSize="11.5"/>
                    <ItemsControl x:Name="Shortcuts" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    <Button Content="Reset to defaults" Click="OnResetKeys" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid DataContext="{Binding Settings}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="STORAGE" Style="{StaticResource H2}" Grid.ColumnSpan="3"/>
                    <TextBlock Grid.Row="1" Text="Music library folder" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MusicFolder}" Margin="0,3"/><Button Grid.Row="1" Grid.Column="2" Content="…" Click="OnMusicFolder" Margin="4,0,0,0"/>
                    <TextBlock Grid.Row="2" Text="Recordings folder" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DataContext.Station.Profile.Recording.Folder, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Text="Backups folder" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BackupFolder}" Margin="0,3"/><Button Grid.Row="3" Grid.Column="2" Content="…" Click="OnBackupFolder" Margin="4,0,0,0"/>
                    <TextBlock Grid.Row="4" Text="Logs folder" VerticalAlignment="Center"/><TextBlock x:Name="LogsPath" Grid.Row="4" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"/><Button Grid.Row="4" Grid.Column="2" Content="Open" Click="OnOpenLogs" Margin="4,0,0,0"/>
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Back up now" Click="OnBackup" Margin="0,0,8,0"/><Button Content="Restore from backup…" Click="OnRestore"/>
                        <TextBlock x:Name="BackupMsg" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel DataContext="{Binding Settings}">
                    <TextBlock Text="ADVANCED" Style="{StaticResource H2}"/>
                    <DockPanel Margin="0,0,0,6"><TextBlock Text="FFmpeg path" Width="140" VerticalAlignment="Center"/><Button Content="Detect" Click="OnDetectFfmpeg" DockPanel.Dock="Right" Margin="4,0,0,0"/><Button Content="…" Click="OnFfmpeg" DockPanel.Dock="Right" Margin="4,0,0,0"/><TextBox Text="{Binding FfmpegPath}" ToolTip="(automatic: PATH / app folder)"/></DockPanel>
                    <TextBlock x:Name="FfmpegInfo" Style="{StaticResource Muted}" FontSize="11.5"/>
                    <CheckBox Content="Debug logging" IsChecked="{Binding DebugLogging}" Click="OnDebug" Margin="0,6,0,0"/>
                    <Button Content="Copy diagnostics to clipboard" Click="OnDiag" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" Margin="0,0,0,20"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
