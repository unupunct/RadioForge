<UserControl x:Class="RadioForge.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RadioForge.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Stream Monitoring &amp; Statistics" Style="{StaticResource H1}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="WindowBox" Width="130" SelectionChanged="OnWindow" Margin="0,0,8,0"/>
                    <Button Content="⭳ Export CSV" Click="OnExport"/>
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="8">
                <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" MaxHeight="230">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Server" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Bitrate" Binding="{Binding Bitrate}" Width="80"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="150"/>
                        <DataGridTextColumn Header="Uptime" Binding="{Binding Uptime}" Width="80"/>
                        <DataGridTextColumn Header="Reconn." Binding="{Binding Reconnects}" Width="60"/>
                        <DataGridTextColumn Header="Listeners" Binding="{Binding Listeners}" Width="70"/>
                        <DataGridTextColumn Header="Available" Binding="{Binding Availability}" Width="75"/>
                        <DataGridTextColumn Header="Last success" Binding="{Binding LastSuccess}" Width="95"/>
                        <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,5,10"><StackPanel><TextBlock Text="BITRATE HISTORY (kbps)" Style="{StaticResource H2}"/><c:LineChart x:Name="ChBitrate" Height="170"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,10"><StackPanel><TextBlock Text="LISTENER HISTORY (where supported)" Style="{StaticResource H2}"/><c:LineChart x:Name="ChListeners" Height="170"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,5,10"><StackPanel><TextBlock Text="STREAM AVAILABILITY (100 = streaming)" Style="{StaticResource H2}"/><c:LineChart x:Name="ChAvail" Height="170"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,10"><StackPanel><TextBlock Text="CONNECTION STABILITY (100 ok · 50 retrying · 0 failed)" Style="{StaticResource H2}"/><c:LineChart x:Name="ChStab" Height="170"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="BROADCASTING UPTIME" Style="{StaticResource H2}"/><TextBlock x:Name="UptimeText" FontSize="15"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="EVENT LOG" Style="{StaticResource H2}"/><ListBox x:Name="Events" Height="190" FontFamily="Consolas" FontSize="11.5" Background="Transparent"/></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
