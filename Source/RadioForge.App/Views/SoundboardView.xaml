<UserControl x:Class="RadioForge.App.Views.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Soundboard — jingles &amp; effects" Style="{StaticResource H1}" Margin="0,0,0,10"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel x:Name="Pages" Orientation="Horizontal"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <ToggleButton x:Name="PreviewMode" Content="🎧 Preview mode" Margin="0,0,8,0" ToolTip="Pads play on the default speakers only — nothing goes on air"/>
                <Button Content="■ Stop all" Click="OnStopAll" Style="{StaticResource DangerButton}"/>
            </StackPanel>
            <TextBlock x:Name="Hint" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0" Text="Click to play · drop an audio file onto a pad · right-click or ✎ to edit"/>
        </DockPanel>
        <ItemsControl x:Name="PadList" Grid.Row="2">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" CornerRadius="12" Background="{Binding Color, Converter={StaticResource HexBrush}}" AllowDrop="True" Drop="OnPadDrop" MouseRightButtonUp="OnPadEdit" Tag="{Binding}"
                            BorderThickness="2" MinHeight="96">
                        <Border.Style>
                            <Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="BorderBrush" Value="White"/></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                        <Grid>
                            <Button Background="Transparent" BorderThickness="0" Click="OnPadClick" Tag="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                    <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="#CCFFFFFF" Text="{Binding Hotkey, StringFormat='⌨ {0}'}" Visibility="{Binding Hotkey, Converter={StaticResource NullVis}}"/>
                                    <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="#CCFFFFFF" Text="{Binding Mode}"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                                <Button Content="■" Click="OnPadStop" Tag="{Binding}" Padding="6,1" Margin="0,0,3,0" ToolTip="Stop"/>
                                <Button Content="✎" Click="OnPadEdit" Tag="{Binding}" Padding="6,1" ToolTip="Edit pad"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Index, StringFormat='{}{0}'}" FontSize="9" Foreground="#99FFFFFF" Margin="8,4" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
