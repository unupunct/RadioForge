<UserControl x:Class="RadioForge.App.Views.StudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RadioForge.App.Controls">
    <Grid x:Name="Split">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="560"/><ColumnDefinition Width="8"/><ColumnDefinition Width="400" MinWidth="280"/></Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" Cursor="SizeWE" ToolTip="Drag to resize"/>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Studio — live mixing console" Style="{StaticResource H1}"/>
                <TextBlock Text="Solo affects the program bus (what listeners hear)." Style="{StaticResource Muted}" Margin="16,8,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Engine.Strips}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <Grid Grid.Row="1" Margin="0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <c:LevelBar Meter="{Binding Meter}" Grid.Column="0" Width="34" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                        <Slider Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding Volume}" HorizontalAlignment="Center" Margin="4,0" TickFrequency="0.5" TickPlacement="BottomRight" ToolTip="Fader"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="{Binding Volume, StringFormat={}{0:P0}}" HorizontalAlignment="Center" Margin="0,0,0,6" FontFamily="Consolas" Style="{StaticResource Muted}"/>
                                    <UniformGrid Grid.Row="3" Rows="1">
                                        <ToggleButton Content="M" IsChecked="{Binding Mute}" Margin="0,0,3,0" ToolTip="Mute"/>
                                        <ToggleButton Content="S" IsChecked="{Binding Solo}" Margin="3,0,0,0" ToolTip="Solo"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="2,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="MASTER" Style="{StaticResource H2}"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <c:LevelBar Meter="{Binding Engine.MasterMeter}" Width="56" Margin="0,0,10,0" HorizontalAlignment="Right"/>
                            <Slider Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1.5" Value="{Binding Station.Profile.Audio.MasterVolume}" Margin="4,0" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Station.Profile.Audio.MasterVolume, StringFormat={}{0:P0}}" FontFamily="Consolas" Style="{StaticResource Muted}" Margin="6,0,0,0"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <c:LabeledSlider Label="Balance" Minimum="-1" Maximum="1" Value="{Binding Station.Profile.Audio.Balance, Mode=TwoWay}" LabelWidth="56" Format="+0.00;-0.00;0.00"/>
                            <CheckBox Content="Master limiter" IsChecked="{Binding Station.Profile.Audio.LimiterEnabled}" Margin="0,4,0,0"/>
                            <c:LabeledSlider Label="Ceiling" Minimum="-12" Maximum="0" Value="{Binding Station.Profile.Audio.LimiterCeilingDb, Mode=TwoWay}" LabelWidth="56" Unit="dB" Format="0.0"/>
                            <CheckBox Content="Output to speakers" IsChecked="{Binding Station.Profile.Audio.SpeakersEnabled}" ToolTip="Routing: the program always goes to the stream; this only controls local monitoring."/>
                            <TextBlock Text="{Binding OutputText}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel DataContext="{Binding Station.Profile.Audio.Mic}">
                        <TextBlock Text="MICROPHONE" Style="{StaticResource H2}"/>
                        <ComboBox x:Name="MicDevice" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DeviceId}" SelectionChanged="OnMicDevice" Margin="0,0,0,6"/>
                        <UniformGrid Rows="1" Margin="0,0,0,6">
                            <ToggleButton Content="🔇 Mute" IsChecked="{Binding Muted}" Margin="0,0,4,0"/>
                            <ToggleButton Content="Push-to-talk" IsChecked="{Binding PushToTalk}" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <Button x:Name="PttBtn" Content="HOLD TO TALK" Margin="0,0,0,6" Height="34" PreviewMouseLeftButtonDown="OnPttDown" PreviewMouseLeftButtonUp="OnPttUp" MouseLeave="OnPttUp"/>
                        <c:LabeledSlider Label="Gain" Minimum="-20" Maximum="30" Step="0.5" Value="{Binding GainDb, Mode=TwoWay}" Unit="dB" Format="0.0"/>
                        <CheckBox Content="Noise gate" IsChecked="{Binding GateEnabled}"/>
                        <c:LabeledSlider Label="  Threshold" Minimum="-80" Maximum="-10" Value="{Binding GateThresholdDb, Mode=TwoWay}" Unit="dB" Format="0"/>
                        <CheckBox Content="Compressor" IsChecked="{Binding CompressorEnabled}"/>
                        <c:LabeledSlider Label="  Threshold" Minimum="-40" Maximum="0" Value="{Binding CompThresholdDb, Mode=TwoWay}" Unit="dB" Format="0"/>
                        <c:LabeledSlider Label="  Ratio" Minimum="1" Maximum="10" Value="{Binding CompRatio, Mode=TwoWay}" Unit=":1" Format="0.0"/>
                        <c:LabeledSlider Label="  Makeup" Minimum="0" Maximum="12" Value="{Binding CompMakeupDb, Mode=TwoWay}" Unit="dB" Format="0.0"/>
                        <CheckBox Content="Equalizer" IsChecked="{Binding EqEnabled}"/>
                        <c:LabeledSlider Label="  Low 120 Hz" Minimum="-12" Maximum="12" Value="{Binding EqLowDb, Mode=TwoWay}" Unit="dB" Format="0.0"/>
                        <c:LabeledSlider Label="  Mid 1.5 kHz" Minimum="-12" Maximum="12" Value="{Binding EqMidDb, Mode=TwoWay}" Unit="dB" Format="0.0"/>
                        <c:LabeledSlider Label="  High 6 kHz" Minimum="-12" Maximum="12" Value="{Binding EqHighDb, Mode=TwoWay}" Unit="dB" Format="0.0"/>
                        <c:LabeledSlider Label="Reverb" Minimum="0" Maximum="1" Value="{Binding ReverbMix, Mode=TwoWay}" Format="P0"/>
                        <c:LabeledSlider Label="Echo" Minimum="0" Maximum="0.8" Value="{Binding EchoMix, Mode=TwoWay}" Format="P0"/>
                        <c:LabeledSlider Label="  Delay" Minimum="60" Maximum="1000" Step="10" Value="{Binding EchoDelayMs, Mode=TwoWay}" Unit="ms" Format="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel DataContext="{Binding Station.Profile.Audio.Mic}">
                        <TextBlock Text="DUCKING — music lowers while the DJ speaks" Style="{StaticResource H2}"/>
                        <CheckBox Content="Enable ducking" IsChecked="{Binding DuckingEnabled}"/>
                        <c:LabeledSlider Label="Amount" Minimum="0" Maximum="40" Value="{Binding DuckAmountDb, Mode=TwoWay}" Unit="dB" Format="0"/>
                        <c:LabeledSlider Label="Threshold" Minimum="-70" Maximum="-10" Value="{Binding DuckThresholdDb, Mode=TwoWay}" Unit="dB" Format="0"/>
                        <c:LabeledSlider Label="Attack" Minimum="5" Maximum="500" Value="{Binding DuckAttackMs, Mode=TwoWay}" Unit="ms" Format="0"/>
                        <c:LabeledSlider Label="Release" Minimum="100" Maximum="4000" Step="50" Value="{Binding DuckReleaseMs, Mode=TwoWay}" Unit="ms" Format="0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MONITORING &amp; TEST" Style="{StaticResource H2}"/>
                        <TextBlock Text="Voice monitoring is OFF by default to prevent feedback. Choose headphones that differ from the program output, then enable it." Style="{StaticResource Muted}" FontSize="11.5"/>
                        <ComboBox x:Name="MonDevice" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Station.Profile.Audio.Mic.MonitorDeviceId}" Margin="0,6"/>
                        <ToggleButton x:Name="MonToggle" Content="🎧 Voice monitoring" Click="OnMonitor" Margin="0,0,0,6"/>
                        <Button Content="🎙 Microphone test (record 4 s, play back)" Click="OnMicTest"/>
                        <TextBlock x:Name="TestText" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
