<UserControl x:Class="RadioForge.App.Views.OnAirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RadioForge.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Center">
            <TextBlock Text="On Air — simple studio" Style="{StaticResource H1}" Margin="0,0,0,12"/>

            <Border x:Name="HintCard" Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{DynamicResource WarnBrush}" Visibility="{Binding SetupHint, Converter={StaticResource NullVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SetupHint}" TextWrapping="Wrap" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Open Streaming Servers" Click="OnGoServers" Margin="0,0,8,0"/>
                        <Button Content="Add sample music and jingles" Click="OnSamples"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding OnAirText}" Style="{StaticResource Big}" FontSize="34"/>
                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource Muted}"/>
                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding StreamsText, Mode=OneWay}"/>  ·  <Run Text="{Binding ListenersText, Mode=OneWay}"/>  ·  uptime <Run Text="{Binding UptimeText, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding BroadcastButtonText}" Command="{Binding ToggleBroadcastCommand}" Style="{StaticResource AccentButton}" Height="76" MinWidth="260" FontSize="20" AutomationProperties.Name="Start or stop the broadcast"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" CornerRadius="10" Background="{DynamicResource Panel2Brush}" Margin="0,0,16,0"><Image Source="{Binding Artwork, Converter={StaticResource BytesImage}}" Stretch="UniformToFill"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NOW PLAYING" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding NowPlayingText}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ArtistText}" Style="{StaticResource Muted}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Value="{Binding TrackProgress, Mode=OneWay}" Maximum="1" Height="5" Margin="0,8,0,2" AutomationProperties.Name="Track progress"/>
                        <TextBlock Text="{Binding NextText, StringFormat='Next: {0}'}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <UniformGrid Rows="1">
                    <Button Content="⏮  Previous" Command="{Binding PreviousCommand}" Height="60" FontSize="16" Margin="0,0,8,0" HorizontalAlignment="Stretch"/>
                    <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" Height="60" FontSize="18" Margin="0,0,8,0" HorizontalAlignment="Stretch"/>
                    <Button Content="⏭  Next" Command="{Binding NextCommand}" Height="60" FontSize="16" HorizontalAlignment="Stretch"/>
                </UniformGrid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="MICROPHONE" Style="{StaticResource H2}"/>
                        <Button Command="{Binding ToggleMicCommand}" Height="60" FontSize="18" HorizontalAlignment="Stretch" Content="{Binding MicText, StringFormat='🎤  {0}'}" AutomationProperties.Name="Turn the microphone on or off"/>
                        <c:LevelBar Meter="{Binding Engine.InputMeter}" IsHorizontal="True" Height="14" Margin="0,8,0,0" AutomationProperties.Name="Microphone level"/>
                        <TextBlock Text="{Binding DuckText}" Foreground="{DynamicResource WarnBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="VOLUME" Style="{StaticResource H2}"/>
                        <c:LabeledSlider Label="Master" Minimum="0" Maximum="1.5" Value="{Binding Station.Profile.Audio.MasterVolume, Mode=TwoWay}" Format="P0" LabelWidth="60"/>
                        <c:LabeledSlider Label="Music" Minimum="0" Maximum="1.5" Value="{Binding Engine.MusicStrip.Volume, Mode=TwoWay}" Format="P0" LabelWidth="60"/>
                        <c:LevelBar Meter="{Binding Engine.MasterMeter}" IsHorizontal="True" Height="14" Margin="0,6,0,0" AutomationProperties.Name="Program level"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="JINGLES" Style="{StaticResource H2}"/>
                    <UniformGrid x:Name="Pads" Rows="1"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
