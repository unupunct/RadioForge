<UserControl x:Class="RadioForge.App.Views.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Recordings" Style="{StaticResource H1}" Margin="0,0,0,10"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="RECORD" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="RecBtn" Content="⏺ Start recording" Click="OnRec" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                        <Button x:Name="PauseBtn" Content="❚❚ Pause" Click="OnPause" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding RecordingText}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="Msg" Style="{StaticResource Muted}"/>
                    <TextBlock Text="Streaming and recording can run at the same time." Style="{StaticResource Muted}" FontSize="11.5"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid DataContext="{Binding Station.Profile.Recording}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Source" VerticalAlignment="Center"/><ComboBox x:Name="SrcBox" Grid.Column="1" SelectedItem="{Binding Source}" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Text="Format" VerticalAlignment="Center"/><ComboBox x:Name="FmtBox" Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Format}" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Text="MP3 bitrate" VerticalAlignment="Center"/><ComboBox x:Name="KbpsBox" Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Mp3Kbps}" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Text="Folder" VerticalAlignment="Center"/>
                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3"><Button Content="…" DockPanel.Dock="Right" Click="OnFolder" Margin="4,0,0,0"/><TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" ToolTip="(Music\RadioForge Recordings)"/></DockPanel>
                    <TextBlock Grid.Row="4" Text="File name" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NamePattern}" Margin="0,3" ToolTip="Tokens: {station} {source} {date} {time}"/>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel Margin="4,0,0,8">
                    <TextBlock Text="HISTORY" Style="{StaticResource H2}" Margin="0,6,20,0"/>
                    <Button Content="▶ Play" Click="OnPlay" Margin="0,0,6,0"/><Button Content="■ Stop playback" Click="OnStopPlay" Margin="0,0,6,0"/>
                    <Button Content="Open folder" Click="OnOpenFolder" Margin="0,0,6,0"/><Button Content="🗑 Delete" Click="OnDelete"/>
                </WrapPanel>
                <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="Transparent" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Started" Binding="{Binding Started, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurText}" Width="80"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80"/>
                        <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
