<Window x:Class="RadioForge.App.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RadioForge.App.Views"
        Title="RadioForge — Station Setup" Width="760" Height="640" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextBrush}" Icon="/Assets/radioforge.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal"><Image Source="/Assets/icon256.png" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock Text="Set up your radio station" Style="{StaticResource H1}" VerticalAlignment="Center"/></StackPanel>
            <TextBlock x:Name="StepText" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            <ProgressBar x:Name="Prog" Maximum="6" Height="4" Margin="0,8,0,16" Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- 1 -->
            <StackPanel x:Name="S1">
                <TextBlock Text="Step 1 — Radio information" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Station name" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Description" VerticalAlignment="Center"/><TextBox x:Name="Desc" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Genre" VerticalAlignment="Center"/><TextBox x:Name="Genre" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Website" VerticalAlignment="Center"/><TextBox x:Name="Web" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Text="Station logo" VerticalAlignment="Center"/><DockPanel Grid.Row="4" Grid.Column="1" Margin="0,4"><Button Content="Browse…" DockPanel.Dock="Right" Click="OnLogo" Margin="6,0,0,0"/><TextBox x:Name="Logo"/></DockPanel>
                    <TextBlock Grid.Row="5" Text="Country" VerticalAlignment="Center"/><ComboBox x:Name="Country" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="6" Text="Time zone" VerticalAlignment="Center"/><ComboBox x:Name="Tz" Grid.Row="6" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Margin="0,4"/>
                </Grid>
            </StackPanel>
            <!-- 2 -->
            <StackPanel x:Name="S2" Visibility="Collapsed">
                <TextBlock Text="Step 2 — Streaming server" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><RadioButton x:Name="RbIce" Content="Icecast" IsChecked="True" Margin="0,0,24,0" GroupName="t"/><RadioButton x:Name="RbSc" Content="SHOUTcast" GroupName="t"/><CheckBox x:Name="SkipServer" Content="Skip — I will add a server later" Margin="40,0,0,0"/></StackPanel>
                <Grid x:Name="ServerGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Server address" VerticalAlignment="Center"/><TextBox x:Name="Host" Grid.Column="1" Margin="0,4" ToolTip="e.g. stream.myhost.com (no http://)"/>
                    <TextBlock Grid.Column="3" Text="Port" VerticalAlignment="Center"/><TextBox x:Name="Port" Grid.Column="4" Text="8000" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Source password" VerticalAlignment="Center"/><PasswordBox x:Name="Pw" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                    <TextBlock x:Name="MountLabel" Grid.Row="2" Text="Mount point" VerticalAlignment="Center"/><TextBox x:Name="Mount" Grid.Row="2" Grid.Column="1" Text="/stream" Margin="0,4"/>
                </Grid>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <TextBlock x:Name="Help" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                </Border>
            </StackPanel>
            <!-- 3 -->
            <StackPanel x:Name="S3" Visibility="Collapsed">
                <TextBlock Text="Step 3 — Audio devices" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock x:Name="DevInfo" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Microphone" VerticalAlignment="Center"/><ComboBox x:Name="MicBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Speakers / output" VerticalAlignment="Center"/><ComboBox x:Name="OutBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4"/>
                </Grid>
                <Button Content="↻ Re-detect devices" Click="OnDetect" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
            <!-- 4 -->
            <StackPanel x:Name="S4" Visibility="Collapsed">
                <TextBlock Text="Step 4 — Stream quality" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel>
                    <RadioButton x:Name="Q64" Content="Low bandwidth — 64 kbps" GroupName="q" Margin="0,4"/>
                    <RadioButton x:Name="Q128" Content="Standard — 128 kbps (recommended)" GroupName="q" IsChecked="True" Margin="0,4"/>
                    <RadioButton x:Name="Q192" Content="High quality — 192 kbps" GroupName="q" Margin="0,4"/>
                    <RadioButton x:Name="Q256" Content="Premium — 256 kbps" GroupName="q" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4"><RadioButton x:Name="QC" Content="Custom:" GroupName="q"/><TextBox x:Name="QCv" Text="160" Width="70" Margin="8,0"/><TextBlock Text="kbps" VerticalAlignment="Center"/></StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" Text="Streams are encoded as MP3 (works everywhere). Actual compatibility and the maximum bitrate depend on your streaming host — check the limits of your hosting plan. You can add more servers with different formats later."/>
            </StackPanel>
            <!-- 5 -->
            <StackPanel x:Name="S5" Visibility="Collapsed">
                <TextBlock Text="Step 5 — Connection test" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Button x:Name="TestBtn" Content="⚡ Test the connection" Click="OnTest" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="TestSummary" FontWeight="SemiBold" Margin="0,12,0,6" TextWrapping="Wrap"/>
                <ItemsControl x:Name="TestSteps">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Status, Converter={x:Static local:StepIcon.Instance}}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"/></Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TestSkip" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            </StackPanel>
            <!-- 6 -->
            <StackPanel x:Name="S6" Visibility="Collapsed">
                <TextBlock Text="Step 6 — Ready!" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Style="{StaticResource Card}"><TextBlock x:Name="Summary" TextWrapping="Wrap" LineHeight="22"/></Border>
                <Button Content="📻   START YOUR RADIO" Click="OnFinish" Style="{StaticResource AccentButton}" FontSize="20" Height="64" Margin="0,24,0,8"/>
                <Button Content="Save and finish without going on air" Click="OnSaveOnly"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Skip setup — configure later" Click="OnSkip" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackBtn" Content="◀ Back" Click="OnBack" Margin="0,0,8,0" MinWidth="90"/><Button x:Name="NextBtn" Content="Next ▶" Click="OnNext" Style="{StaticResource AccentButton}" MinWidth="110"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
