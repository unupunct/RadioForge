<UserControl x:Class="RadioForge.App.Views.SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Broadcast Scheduler" Style="{StaticResource H1}" Margin="0,0,24,0"/>
            <Button Content="◀" Click="OnPrev" Margin="0,0,4,0"/><Button Content="Today" Click="OnToday" Margin="0,0,4,0"/><Button Content="▶" Click="OnNext" Margin="0,0,12,0"/>
            <TextBlock x:Name="RangeText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <RadioButton x:Name="WeekBtn" Content="Week" GroupName="v" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Padding="14,6" Checked="OnView"/>
            <RadioButton x:Name="MonthBtn" Content="Month" GroupName="v" Style="{StaticResource {x:Type ToggleButton}}" Padding="14,6" Margin="4,0,0,0" Checked="OnView"/>
            <Button Content="＋ New event" Click="OnNew" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            <TextBlock x:Name="TzText" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid x:Name="WeekHost">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Canvas x:Name="Header" ClipToBounds="True"/>
                    <ScrollViewer x:Name="WeekScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="WeekCanvas" Height="960" SizeChanged="OnCanvasSize"/>
                    </ScrollViewer>
                </Grid>
                <UniformGrid x:Name="MonthGrid" Columns="7" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="ConflictText" TextWrapping="Wrap"/>
                <TextBlock Text="The scheduler runs inside the application, also while the window is minimized to the tray. It cannot broadcast while Windows is off or RadioForge is closed." Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
